# ==========================================
# Telegram Bots Configuration Template
# Скопируйте этот файл в .env и укажите ваши реальные токены
# ВНИМАНИЕ: Файл .env никогда не должен попадать в Git!
# ==========================================

# База данных и шина сообщений (Redis)
DATABASE_URL=sqlite+aiosqlite:///shared/data.db
REDIS_URL=redis://localhost:6379/0

# Токены ботов от @BotFather
BOT_01_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example1
BOT_02_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example2
BOT_03_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example3
BOT_04_TOKEN=
BOT_05_TOKEN=

# Общие настройки окружения
ENVIRONMENT=development
DEBUG=True
ADMIN_USER_IDS=123456789,987654321
