generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String   @default("Главный администратор")
  passwordHash   String
  clearanceLevel Int      @default(4) // 4 = Superadmin, 3 = Admin, 2 = Moderator
  role           String   @default("ADMIN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Bot {
  id               String            @id @default(uuid())
  botId            String            @unique // e.g. "BR-8921", "bot_01"
  name             String // e.g. "Марк Уитфилд", "Дворецкий Джеймс"
  username         String?           @default("")
  token            String // Telegram bot token
  avatarUrl        String?
  role             String            @default("Подозреваемый")
  status           String            @default("ACTIVE") // ACTIVE, OFFLINE, ERROR
  isActive         Boolean           @default(true)
  isMainHub        Boolean           @default(false) // True для Главного бота-хаба / Лаунчера
  onboardingSteps  String?           @default("[]") // JSON массив шагов воронки [{id, text, delaySeconds, mediaUrl, buttonText}]
  isGuilty         Boolean           @default(false) // True если бот - настоящий убийца в Деле
  secretAlibi      String?           // Секрет при расколе (у невиновных - правда, у убийцы - нескладная ложь)
  lastPing         DateTime?
  groupId          String?           // Case ID
  group            Group?            @relation(fields: [groupId], references: [id])
  model            String            @default("gemini-3.6-flash")
  temperature      Float             @default(0.7)
  reasoningEnabled Boolean           @default(false)
  prompt           String?           // Сплошной системный промпт бота
  orderIndex       Int               @default(0) // Порядковый номер подозреваемого в деле
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dialogues        UserDialogueLog[]
}

model Group {
  id                 String   @id @default(uuid())
  code               String   @unique // e.g. "case_blackwood"
  title              String // e.g. "Дело №1: Тайна особняка Блэквуд"
  status             String   @default("ACTIVE") // ACTIVE, ARCHIVED
  lore               String   @default("") // Описание / обстоятельства преступления
  prompt             String?  @default("") // Групповой системный контекст / лор дела
  solutionTruth      String?  @default("") // Закрытая истина дела: кто убийца, мотив, как произошло
  winText            String?  @default("") // Текст триумфальной победы (при верном обвинении)
  loseText           String?  @default("") // Текст поражения (при ошибочном обвинении)
  accusationAliases  String?  @default("{}") // JSON алиасов подозреваемых для свободного ввода
  isGuiltyBotId      String?  // ID бота-убийцы
  starsPrice         Int      @default(50) // Стоимость дела в Telegram Stars (0 = бесплатно)
  coverUrl           String?
  bots               Bot[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TelegramUser {
  id              String            @id @default(uuid())
  telegramId      String            @unique
  username        String?
  firstName       String?
  lastName        String?
  status          String            @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  stage           String            @default("ONBOARDING") // ONBOARDING, INVESTIGATING, ACCUSING, SOLVED, FAILED
  stageStatus     String            @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED
  funnelStep      Int               @default(0) // Текущий шаг в воронке онбординга
  funnelCompleted Boolean           @default(false) // Завершена ли воронка
  activeCaseId    String?           // ID текущего расследуемого дела
  caseProgress  String?           @default("{}") // JSON с прогрессом допросов и шкалой давления
  currentBotId  String?           // Последний активный бот
  firstSeen     DateTime          @default(now())
  lastActive    DateTime          @default(now())
  dialogueCount Int               @default(0)
  tokensUsed    Int               @default(0)
  casesAccessed String?           @default("[]")
  spentAmount   Float             @default(0.0)
  dialogues     UserDialogueLog[]
}

model UserDialogueLog {
  id          String       @id @default(uuid())
  userId      String
  user        TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId       String
  bot         Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  userMessage String
  botResponse String
  modelUsed   String       @default("gemini-2.0-flash")
  tokens      Int          @default(0)
  status      String       @default("SUCCESS") // SUCCESS, FLAGGED, ERROR
  createdAt   DateTime     @default(now())
}

model GeminiApiKey {
  id              String    @id @default(uuid())
  name            String    @default("Gemini Key")
  key             String // Secret API Key
  provider        String    @default("gemini") // gemini, openai, anthropic, openrouter, custom
  status          String    @default("ACTIVE") // ACTIVE, EXHAUSTED, COOLDOWN, ERROR
  isPrimary       Boolean   @default(false)
  latencyMs       Int       @default(120)
  requestCount    Int       @default(0)
  supportedModels String?   @default("[]") // JSON list of available models
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Broadcast {
  id          String    @id @default(uuid())
  code        String    @unique // e.g. "BC-8892"
  message     String
  mediaUrl    String?
  botId       String?   // Опциональный бот для рассылки
  audience    String    @default("ALL") // ALL, INACTIVE
  status      String    @default("DELIVERED") // SCHEDULED, DELIVERED, IN_PROGRESS, ERROR
  sentCount   Int       @default(0)
  totalTarget Int       @default(0)
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
}

model GlobalSetting {
  id             String   @id @default("global")
  systemPrompt   String
  primaryEngine  String   @default("gemini-2.0-flash")
  apiKeyMode     String   @default("AUTO_ROTATION") // AUTO_ROTATION, FIXED
  activeApiKeyId String?
  fallbackBotId  String?  // ID резервного бота при сбое
  autoFallback   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}
